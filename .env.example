# OpenRouter credentials stay on the backend. Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=300
# Includes visible output and any model reasoning tokens.
OPENROUTER_MAX_COMPLETION_TOKENS=32000
API_PROXY_TIMEOUT_MS=330000
# Optional for non-Docker backend runs. Docker uses /data/lecture_uploads.
LECTURE_STORAGE_PATH=
